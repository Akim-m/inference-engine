REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
ADMIN_KEY=change-me-to-a-secure-random-string
# Enables the key-less /chat page + /chat/api proxy. Set to a key you minted via
# POST /v1/admin/keys. Leave empty to keep chat disabled (proxy returns 503).
CHAT_API_KEY=
# /chat conversation memory bounds (optional; defaults shown).
# CHAT_MEMORY_CHAR_BUDGET=8000
# CHAT_MEMORY_MAX_TURNS=12
# CHAT_MEMORY_TTL_SECONDS=1800
HF_TOKEN=
MODEL_ID=google/medgemma-4b-it
MODEL_REVISION=
TEMP_DIR=
JOB_TTL_SECONDS=3600
MAX_PENDING_JOBS_PER_KEY=10
RATE_LIMIT_PER_MINUTE=60
# Serial service: 1 worker pulls one job at a time; the rest queue in Redis.
# Raise only alongside vLLM MAX_NUM_SEQS below (they must stay aligned).
WORKER_REPLICAS=1

# vLLM serving (worker is an HTTP client of this server)
VLLM_URL=http://vllm:8001/v1
# vLLM server launch flags (consumed by docker-compose, not the app).
# Serial single-user config for an 8GB GPU: MAX_NUM_SEQS=1 pairs with WORKER_REPLICAS=1
# above (one request at a time). MAX_MODEL_LEN 6144 covers the app's ~3.5k-token request
# cap (8000-char memory + 1024-token answers) and fits the ~9.5k-token KV pool at 0.85.
# On WSL2 the Windows host can spike VRAM invisibly; if vLLM ENOMEMs on load / mid-run,
# lower GPU_MEMORY_UTILIZATION to 0.80 (~1.6GB slack vs ~1.0-1.5 at 0.85).
QUANTIZATION=fp8
MAX_MODEL_LEN=6144
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.85
